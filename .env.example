# Generate at least 50 random characters and load it through a secret manager.
AUDIT_SECRET_KEY=replace-with-a-random-secret-of-at-least-50-characters
AUDIT_HOSTS=audit.example.com
# Enable only when Django is reachable exclusively through a trusted proxy that
# replaces X-Forwarded-For and X-Forwarded-Proto.
AUDIT_TRUST_PROXY=1
